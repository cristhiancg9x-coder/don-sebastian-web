---
import { Flower2, Truck, Gift, PartyPopper } from 'lucide-react';

const services = [
  {
    icon: Flower2,
    title: "Ramos de Limpia Pipas",
    description: "Ramos eternos y personalizados para cualquier ocasión. Tú eliges las flores y colores, nosotros los creamos a mano."
  },
  {
    icon: Gift,
    title: "Detalles Especiales",
    description: "Cajas personalizadas con flores, figuras y detalles únicos para sorprender a esa persona especial."
  },
  {
    icon: Truck,
    title: "Envíos Seguros",
    description: "Llevamos tus detalles a la puerta de tu casa en todo Arequipa. Empaques hermosos que protegen tu regalo."
  },
  {
    icon: PartyPopper,
    title: "Recuerdos para Eventos",
    description: "Pequeños detalles en limpia pipas para que los invitados de tu boda, quinceañero o evento se lleven el mejor recuerdo."
  }
];
---

<section id="servicios" class="py-24 bg-[#FCE4EC] relative overflow-hidden">
  
  <div class="absolute top-0 right-0 -mt-20 -mr-20 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-72 h-72 bg-yellow-400/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    
    <div class="text-center mb-16">
      <h2 class="font-serif text-5xl text-dark mb-4">Nuestros Servicios</h2>
      <p class="text-dark/70 text-lg max-w-2xl mx-auto">
        Más que regalos, creamos recuerdos inolvidables hechos a mano para tus celebraciones.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {services.map((service) => (
        <div class="bg-white p-8 rounded-3xl shadow-lg border border-orange-100 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group text-center">
          
          <div class="w-20 h-20 mx-auto bg-secondary rounded-full flex items-center justify-center mb-6 group-hover:bg-primary group-hover:scale-110 transition-all duration-300">
            <service.icon 
              size={40} 
              className="text-primary group-hover:text-white transition-colors duration-300" 
              strokeWidth={1.5}
            />
          </div>
          
          <h3 class="font-serif text-2xl font-bold text-dark mb-3">
            {service.title}
          </h3>
          
          <p class="text-gray-600 leading-relaxed text-sm">
            {service.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>