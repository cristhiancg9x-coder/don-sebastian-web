---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Feed from "../components/react/Feed.jsx";
import Services from "../components/Services.astro";
import FloatingFlowers from "../components/FloatingFlowers.astro";
import HeroShowcase from "../components/react/HeroShowcase.jsx";
import { Image } from "astro:assets";
import fotoUbicacionImg from "../assets/Foto-de-ubicacion.jpeg";

// DATOS REALES DE LA EMPRESA
const business = {
  name: "Detalles del Corazón",
  address: "El Badén, Av. Jesús 2511, Paucarpata 04001, Arequipa",
  hours: "Lun - Dom: 8:30 AM - 9:00 PM",
  phone: "+51 999 999 999", // (Número referencial)
  googleMapsUrl: "https://goo.gl/maps/TuLinkDeMapsAqui", // Puedes poner el link real si lo tienes
};

// SEO: SCHEMA.ORG PARA NEGOCIOS LOCALES (Invisble para usuarios, oro para Google)
const schemaData = {
  "@context": "https://schema.org",
  "@type": "Store",
  name: business.name,
  image:
    "https://images.unsplash.com/photo-1578985545062-69928b1d9587?q=80&w=1000",
  description:
    "Detalles únicos y personalizados hechos a mano con limpia pipas. Ramos florales, figuras y regalos especiales con envíos en Arequipa, Moquegua y todo el Perú.",
  openingHours: "Mo-Su 08:30-21:00",
  priceRange: "$$",
  areaServed: [
    {
      "@type": "City",
      name: "Arequipa",
    },
    {
      "@type": "City",
      name: "Moquegua",
    },
    {
      "@type": "Country",
      name: "PE",
    },
  ],
  contactPoint: {
    "@type": "ContactPoint",
    telephone: business.phone,
    contactType: "customer service",
    areaServed: "PE",
  },
};
---

<Layout title="Detalles del Corazón | Regalos con Limpia Pipas en Perú">
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <Navbar />

  <main class="bg-pattern-floral min-h-screen">
    <section
      id="inicio"
      class="relative min-h-[90vh] flex items-center justify-center overflow-hidden bg-gray-900"
    >
      <!-- Fondo Animado de Flores -->
      <FloatingFlowers />

      <!-- Layout Principal en Dos Columnas -->
      <div
        class="relative z-10 w-full max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center py-20 mt-10"
      >
        <!-- Contenido Texto (Izquierda) -->
        <div class="text-center lg:text-left text-white animate-fade-in-up">
          <span
            class="inline-block py-2 px-6 border border-white/20 rounded-full bg-primary/20 backdrop-blur-md text-sm font-bold mb-6 tracking-widest text-[#FCE4EC] uppercase shadow-lg"
          >
            🌸 Detalles hechos a mano con amor
          </span>

          <h1
            class="font-serif text-5xl md:text-7xl lg:text-8xl mb-6 drop-shadow-2xl font-bold leading-tight"
          >
            Arte en cada <br class="hidden md:block" />
            <span class="text-primary italic font-script pr-2">detalle</span>
          </h1>

          <p
            class="text-xl md:text-2xl font-light mb-10 text-gray-200 text-shadow-strong max-w-xl mx-auto lg:mx-0"
          >
            Regalos únicos y eternos hechos con <strong>limpia pipas</strong>.
            Sorprende a esa persona especial.
          </p>

          <div
            class="flex flex-col sm:flex-row gap-5 justify-center lg:justify-start"
          >
            <a
              href="#novedades"
              class="bg-primary hover:bg-[#C2185B] text-white text-lg font-bold py-4 px-10 rounded-full shadow-[0_6px_0_rgb(136,14,79)] hover:shadow-[0_3px_0_rgb(136,14,79)] hover:translate-y-1 transition-all"
            >
              Ver Nuestras Creaciones
            </a>
          </div>
        </div>

        <!-- Vitrina Dinámica (Derecha) -->
        <div
          class="flex justify-center items-center w-full px-4 md:px-12 lg:px-0 animate-fade-in"
        >
          <HeroShowcase client:load />
        </div>
      </div>
    </section>
    <section id="novedades" class="py-24 px-4 max-w-7xl mx-auto relative z-10">
      <div class="text-center mb-16">
        <h2 class="font-serif text-5xl text-dark mb-4">
          Nuestras Últimas Creaciones
        </h2>
        <div class="h-1.5 w-24 bg-primary mx-auto rounded-full mb-6"></div>
        <p class="text-dark/80 text-lg font-light">
          Hecho a mano con dedicación!
        </p>

        <Feed client:visible />
        <Services />
      </div>

      <section
        id="contacto"
        class="bg-dark text-[#FFF5E1] py-20 relative overflow-hidden border-t-8 border-primary"
      >
        <div
          class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary via-yellow-400 to-primary"
        >
        </div>

        <div
          class="max-w-6xl mx-auto px-6 relative z-10 flex flex-col md:flex-row gap-16 items-center justify-between"
        >
          <div class="md:w-1/2 text-center md:text-left">
            <h2 class="font-serif text-4xl md:text-5xl mb-8 text-primary">
              Envíos a Todo el Perú
            </h2>

            <p
              class="text-lg font-light text-gray-300 mb-8 max-w-md mx-auto md:mx-0"
            >
              Llevamos nuestro arte directo a tus manos. Somos un emprendimiento
              especializado en entregas rápidas y seguras.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
              <!-- Arequipa -->
              <div
                class="bg-white/5 border border-white/10 p-5 rounded-2xl hover:bg-white/10 hover:border-primary/50 transition-all group"
              >
                <div class="flex items-center gap-3 mb-2">
                  <div
                    class="w-10 h-10 rounded-full bg-primary/20 flex flex-shrink-0 items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-colors"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><path
                        d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"
                      ></path><circle cx="12" cy="10" r="3"></circle></svg
                    >
                  </div>
                  <strong class="text-xl text-white">Arequipa</strong>
                </div>
                <p class="text-sm text-gray-400">
                  Entrega rápida en ciudad blanca y zonas céntricas.
                </p>
              </div>

              <!-- Moquegua -->
              <div
                class="bg-white/5 border border-white/10 p-5 rounded-2xl hover:bg-white/10 hover:border-primary/50 transition-all group"
              >
                <div class="flex items-center gap-3 mb-2">
                  <div
                    class="w-10 h-10 rounded-full bg-primary/20 flex flex-shrink-0 items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-colors"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><path
                        d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"
                      ></path><circle cx="12" cy="10" r="3"></circle></svg
                    >
                  </div>
                  <strong class="text-xl text-white">Moquegua</strong>
                </div>
                <p class="text-sm text-gray-400">
                  Punto de entrega principal y coberturas locales.
                </p>
              </div>

              <!-- Nacional -->
              <div
                class="bg-primary/10 border border-primary/30 p-5 rounded-2xl sm:col-span-2 hover:bg-primary/20 transition-all group overflow-hidden relative"
              >
                <div
                  class="absolute right-0 top-0 w-24 h-24 bg-primary/20 rounded-bl-full -z-10 blur-xl"
                >
                </div>
                <div class="flex items-center gap-3 mb-2">
                  <div
                    class="w-10 h-10 rounded-full bg-primary flex flex-shrink-0 items-center justify-center text-white shadow-lg"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><path
                        d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"
                      ></path><path d="M15 18H9"></path><path
                        d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"
                      ></path><circle cx="17" cy="18" r="2"></circle><circle
                        cx="7"
                        cy="18"
                        r="2"></circle></svg
                    >
                  </div>
                  <strong class="text-xl text-white">Nivel Nacional</strong>
                </div>
                <p class="text-sm text-pink-100">
                  Envíos seguros a través de Olva Courier y Shalom a cualquier
                  todo el Perú.
                </p>
              </div>
            </div>

            <div class="mt-10">
              <a
                href={`https://wa.me/51${business.phone.replace(/\s+/g, "").replace("+51", "")}?text=Hola,%20me%20gustar%C3%ADa%20cotizar%20un%20arreglo%20y%20el%20env%C3%ADo.%20Destino:`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 bg-[#25D366] text-white border-2 border-[#25D366] px-8 py-4 rounded-full font-bold hover:bg-white hover:text-[#25D366] transition-all shadow-lg shadow-[#25D366]/30 group w-full sm:w-auto"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-6 h-6 group-hover:scale-110 transition-transform"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
                  ></path></svg
                >
                COTIZAR ENVÍO POR WHATSAPP
              </a>
            </div>
          </div>

          <div class="relative group animate-fade-in-right">
            <div
              class="absolute -top-4 -left-4 w-24 h-24 bg-[#D2691E]/20 rounded-full blur-xl"
            >
            </div>
            <div
              class="absolute -bottom-4 -right-4 w-32 h-32 bg-primary/20 rounded-full blur-xl"
            >
            </div>

            <Image
              src={fotoUbicacionImg}
              alt="Detalles del corazón empacados y listos para envío a todo el Perú"
              class="w-full h-auto rounded-3xl shadow-2xl relative z-10 transform group-hover:scale-105 transition-transform duration-500 object-cover aspect-[4/3]"
            />

            <!-- Etiqueta Flotante sobre la imagen -->
            <div
              class="absolute bottom-6 right-6 z-20 bg-white/90 backdrop-blur-sm rounded-2xl p-4 shadow-xl border border-white/50 text-dark"
            >
              <span
                class="text-xs font-bold uppercase tracking-wider text-primary mb-1 block"
                >Empaque Premium</span
              >
              <strong class="text-sm">Envíos 100% Seguros 🎁</strong>
            </div>
          </div>
        </div>

        <div
          class="text-center mt-20 pt-8 border-t border-white/10 text-sm text-white/40"
        >
          © {new Date().getFullYear()} Detalles del Corazón. Todos los derechos reservados.
        </div>
      </section>
    </section>
  </main></Layout
>
